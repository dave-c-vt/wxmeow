# wxmeow Weather Application - Environment Configuration
# Copy this file to .env and customize the values for your environment

# Application Settings
FLASK_APP=wxmeow
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Weather Data Storage
# Directory where pickle files are stored (relative to app root)
PICKLE_DIR=.pkl
# Maximum age in seconds before refreshing cached weather data (default: 10 minutes)
PICKLE_MAX_AGE=600
# Enable/disable automatic cleanup of old pickle files
PICKLE_AUTO_CLEANUP=true

# Application Configuration
# Port for the Flask development server
FLASK_PORT=5000
# Host for the Flask development server
FLASK_HOST=0.0.0.0
# Debug mode (true/false)
DEBUG=false

# Weather API Settings
# Timeout for weather API requests (in seconds)
WEATHER_API_TIMEOUT=30
# Maximum retries for failed weather API requests
WEATHER_API_MAX_RETRIES=3
# Default location if none specified
DEFAULT_LOCATION=Boston, MA

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=log_wxmeow.log
# Enable/disable request logging
LOG_REQUESTS=false

# Chart and UI Settings
# Number of days to show in weather charts
CHART_DAYS=7
# Chart refresh interval in seconds
CHART_REFRESH_INTERVAL=300
# Enable/disable chart animations
CHART_ANIMATIONS=true

# Security Settings
# Session timeout in minutes
SESSION_TIMEOUT=60
# Enable/disable CSRF protection
CSRF_ENABLED=true

# Performance Settings
# Enable/disable caching
CACHING_ENABLED=true
# Cache timeout in seconds
CACHE_TIMEOUT=300

# Docker/Production Settings
# External port for Docker container
EXTERNAL_PORT=8000
# Internal application port
INTERNAL_PORT=5000
# Docker container name
CONTAINER_NAME=wxmeow-app

# Database Settings (if database support is added in future)
# DATABASE_URL=sqlite:///wxmeow.db

# External Service Settings
# Geocoding service settings (if used)
# GEOCODING_API_KEY=your-geocoding-api-key
# GEOCODING_SERVICE_URL=https://api.geocoding-service.com

# Monitoring and Health Checks
# Health check endpoint path
HEALTH_CHECK_PATH=/health
# Health check interval for monitoring systems
HEALTH_CHECK_INTERVAL=30

# Development Settings
# Enable/disable auto-reload in development
AUTO_RELOAD=true
# Show detailed error pages
SHOW_ERROR_DETAILS=false

# Backup Settings
# Enable automatic backups of weather data
BACKUP_ENABLED=false
# Backup directory
BACKUP_DIR=backups
# Backup retention days
BACKUP_RETENTION_DAYS=30
