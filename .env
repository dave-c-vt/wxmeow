# wxmeow Weather Application - Environment Configuration
# Development environment settings

# Application Settings
FLASK_APP=wxmeow
FLASK_ENV=development
SECRET_KEY=dev-key-change-in-production-12345
DEBUG=true

# Weather Data Storage
PICKLE_DIR=.pkl
PICKLE_MAX_AGE=600
PICKLE_AUTO_CLEANUP=true

# Application Configuration
FLASK_PORT=5000
FLASK_HOST=127.0.0.1

# Weather API Settings
WEATHER_API_TIMEOUT=30
WEATHER_API_MAX_RETRIES=3
DEFAULT_LOCATION=Boston, MA

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=log_wxmeow.log
LOG_REQUESTS=false

# Chart and UI Settings
CHART_DAYS=7
CHART_REFRESH_INTERVAL=300
CHART_ANIMATIONS=true

# Security Settings
SESSION_TIMEOUT=60
CSRF_ENABLED=true

# Performance Settings
CACHING_ENABLED=true
CACHE_TIMEOUT=300

# Docker/Production Settings
EXTERNAL_PORT=8000
INTERNAL_PORT=5000
CONTAINER_NAME=wxmeow-app

# Health Check Settings
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30

# Development Settings
AUTO_RELOAD=true
SHOW_ERROR_DETAILS=true

# Backup Settings
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Docker Compose Host Directories
HOST_DATA_DIR=./data/.pkl
HOST_LOGS_DIR=./logs
HOST_BACKUP_DIR=./backups
SSL_CERT_DIR=./ssl/letsencrypt

# Network Settings
NETWORK_SUBNET=172.20.0.0/16
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Log Retention
LOG_RETENTION_DAYS=30
